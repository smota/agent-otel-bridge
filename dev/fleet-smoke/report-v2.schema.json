{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smota.github.io/agent-otel-bridge/fleet-smoke/report-v2.schema.json",
  "title": "Fleet smoke report v2",
  "description": "A JSON report item or retained flat RunArtifact produced by dev/fleet-smoke.",
  "oneOf": [
    { "$ref": "#/$defs/reportItem" },
    { "$ref": "#/$defs/retainedArtifact" }
  ],
  "$defs": {
    "reportItem": {
      "type": "object",
      "required": ["schema_version", "run", "summary", "verification", "export"],
      "properties": {
        "schema_version": { "const": 2 },
        "run": { "$ref": "#/$defs/runArtifact" },
        "summary": { "$ref": "#/$defs/summary" },
        "verification": { "type": ["object", "null"] },
        "export": { "type": "array" }
      },
      "additionalProperties": true
    },
    "retainedArtifact": {
      "allOf": [
        { "$ref": "#/$defs/runArtifact" },
        {
          "required": ["schema_version", "summary"],
          "properties": {
            "schema_version": { "const": 2 },
            "summary": { "$ref": "#/$defs/summary" },
            "verification": { "type": ["object", "null"] },
            "export": { "type": "array" }
          }
        }
      ]
    },
    "runArtifact": {
      "type": "object",
      "required": ["plan", "seed", "profile", "run_id", "mode", "spans", "artifact_path"],
      "properties": {
        "plan": { "type": "object" },
        "seed": { "type": "integer", "minimum": 0 },
        "profile": { "type": "string" },
        "run_id": { "type": "string", "minLength": 1 },
        "mode": { "type": "string" },
        "spans": { "type": "array" },
        "artifact_path": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["schema_version", "run_id", "trace_id", "root_span_id", "state", "task_counts", "reproduction", "time", "evaluation", "navigation"],
      "properties": {
        "schema_version": { "const": 2 },
        "run_id": { "type": "string" },
        "trace_id": { "type": "string" },
        "root_span_id": { "type": "string" },
        "state": { "type": "string", "enum": ["completed", "failed", "cancelled", "incomplete"] },
        "task_counts": { "$ref": "#/$defs/taskCounts" },
        "reproduction": { "type": "object", "required": ["seed", "profile", "scenario_version", "plan_hash", "plan_hash_algorithm", "laboratory_version"] },
        "time": { "type": "object", "required": ["search_window_margin_seconds", "search_window"] },
        "evaluation": { "type": "object" },
        "navigation": { "type": "object" }
      },
      "additionalProperties": true
    },
    "taskCounts": {
      "type": "object",
      "required": ["planned", "started", "ended", "not_executed", "control_spans"],
      "properties": {
        "planned": { "type": "integer", "minimum": 0 },
        "started": { "type": "integer", "minimum": 0 },
        "ended": { "type": "integer", "minimum": 0 },
        "not_executed": { "type": "integer", "minimum": 0 },
        "control_spans": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
