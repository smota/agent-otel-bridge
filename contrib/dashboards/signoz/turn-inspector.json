{
  "tags": [
    {
      "key": "persona",
      "value": "debugging"
    },
    {
      "key": "domain",
      "value": "ai-agent"
    }
  ],
  "spec": {
    "display": {
      "name": "AI Agent Turn Inspector & Debugger",
      "description": "Deep turn-by-turn trace viewer and quiescence audit: termination reasons, model distribution, and live trace event stream."
    },
    "duration": "",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "service_name",
          "display": {
            "name": "Service",
            "description": "Filter by OpenTelemetry service name"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": "",
          "capturingRegexp": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "all"
            }
          }
        }
      }
    ],
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Turn Quiescence & Trace Stream",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/why-ended"
              },
              "height": 6,
              "width": 6,
              "x": 0,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/model-share"
              },
              "height": 6,
              "width": 6,
              "x": 6,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/recent-turns"
              },
              "height": 8,
              "width": 12,
              "x": 0,
              "y": 6
            }
          ]
        }
      }
    ],
    "panels": {
      "why-ended": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Why Turns Ended (Quiescence Breakdown)",
            "description": "Termination reasons: NO_TOOL_CALL (healthy quiescence), USER_INTERRUPT (cancelled), TURN_LIMIT (recursion ceiling)."
          },
          "links": null,
          "plugin": {
            "kind": "signoz/PieChartPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "1",
                "unit": ""
              },
              "legend": {
                "position": "right",
                "mode": "list"
              },
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service_name AND agent.hook.event = 'Stop' AND agent.termination_reason EXISTS"
                    },
                    "groupBy": [
                      {
                        "name": "agent.termination_reason",
                        "signal": "traces",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "legend": "{{agent.termination_reason}}",
                    "limit": 10,
                    "order": []
                  }
                }
              }
            }
          ]
        }
      },
      "model-share": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Model Request Distribution",
            "description": "Volume of requests per underlying Foundation Model."
          },
          "links": null,
          "plugin": {
            "kind": "signoz/PieChartPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "1",
                "unit": ""
              },
              "legend": {
                "position": "right",
                "mode": "list"
              },
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name IN $service_name AND gen_ai.request.model EXISTS"
                    },
                    "groupBy": [
                      {
                        "name": "gen_ai.request.model",
                        "signal": "traces",
                        "fieldContext": "attribute",
                        "fieldDataType": "string"
                      }
                    ],
                    "legend": "{{gen_ai.request.model}}",
                    "limit": 10,
                    "order": []
                  }
                }
              }
            }
          ]
        }
      },
      "recent-turns": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Recent Turn Audit Feed",
            "description": "Raw trace feed showing agent name, model, reason, mode, and lines changed."
          },
          "links": null,
          "plugin": {
            "kind": "signoz/ListPanel",
            "spec": {
              "selectFields": [
                {
                  "name": "agent.termination_reason",
                  "fieldContext": "attribute",
                  "signal": "traces",
                  "fieldDataType": "string"
                },
                {
                  "name": "gen_ai.request.model",
                  "fieldContext": "attribute",
                  "signal": "traces",
                  "fieldDataType": "string"
                },
                {
                  "name": "agent.execution.mode",
                  "fieldContext": "attribute",
                  "signal": "traces",
                  "fieldDataType": "string"
                },
                {
                  "name": "agent.git.lines_added",
                  "fieldContext": "attribute",
                  "signal": "traces",
                  "fieldDataType": "int64"
                },
                {
                  "name": "agent.git.lines_deleted",
                  "fieldContext": "attribute",
                  "signal": "traces",
                  "fieldDataType": "int64"
                },
                {
                  "name": "gen_ai.conversation.id",
                  "fieldContext": "attribute",
                  "signal": "traces",
                  "fieldDataType": "string"
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "raw",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "disabled": false,
                    "limit": 25,
                    "source": "",
                    "filter": {
                      "expression": "service.name IN $service_name AND agent.hook.event = 'Stop'"
                    },
                    "order": [
                      {
                        "direction": "desc",
                        "key": {
                          "name": "timestamp",
                          "fieldContext": "",
                          "signal": "",
                          "fieldDataType": ""
                        }
                      }
                    ],
                    "selectFields": [
                      {
                        "name": "agent.termination_reason",
                        "fieldContext": "attribute",
                        "signal": "traces",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "gen_ai.request.model",
                        "fieldContext": "attribute",
                        "signal": "traces",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "agent.execution.mode",
                        "fieldContext": "attribute",
                        "signal": "traces",
                        "fieldDataType": "string"
                      },
                      {
                        "name": "agent.git.lines_added",
                        "fieldContext": "attribute",
                        "signal": "traces",
                        "fieldDataType": "int64"
                      },
                      {
                        "name": "agent.git.lines_deleted",
                        "fieldContext": "attribute",
                        "signal": "traces",
                        "fieldDataType": "int64"
                      },
                      {
                        "name": "gen_ai.conversation.id",
                        "fieldContext": "attribute",
                        "signal": "traces",
                        "fieldDataType": "string"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}