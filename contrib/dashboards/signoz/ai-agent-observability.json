    "variables": [
      {
        "spec": {
          "display": {
            "name": "Service",
            "description": "Filter by OpenTelemetry service name"
          },
          "allowAllValue": true,
          "sort": "alphabetical-asc",
          "allowMultiple": true,
          "plugin": {
            "spec": {
              "name": "service.name",
              "signal": "all"
            },
            "kind": "signoz/DynamicVariable"
          },
          "name": "service_name",
          "customAllValue": "",
          "capturingRegexp": ""
        },
        "kind": "ListVariable"
      }
    ],
    "display": {
      "name": "AI Agent Observability (OpenTelemetry)",
      "description": "Production observability dashboard for autonomous AI coding agents (Google Antigravity, Claude Code, OpenAI Codex, xAI Grok, Inflection Pi) instrumented via agent-otel-bridge. Built on canonical OpenTelemetry GenAI (gen_ai.*) and Agent Lifecycle (agent.*) standards."
    },
    "duration": "",
    "layouts": [
      {
        "spec": {
          "display": {
            "collapse": {
              "open": true
