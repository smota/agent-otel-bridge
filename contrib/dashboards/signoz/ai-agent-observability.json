    "panels": {
      "termination-reasons": {
        "spec": {
          "links": null,
          "plugin": {
            "spec": {
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "unit": "",
                "decimalPrecision": "2"
              },
              "legend": {
                "position": "right",
                "customColors": null,
                "mode": "list"
              }
            },
            "kind": "signoz/PieChartPanel"
          },
          "queries": [
            {
              "spec": {
                "name": "A",
                "plugin": {
                  "spec": {
                    "source": "",
                    "order": [
                      {
                        "key": {
                          "name": "count()",
                          "fieldContext": "",
                          "signal": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "aggregations": [
                      {
                        "expression": "count()"
                      }
                    ],
                    "filter": {
                      "expression": "service.name IN $service_name AND (agent.hook.event = 'Stop' OR agy.hook.event = 'Stop') AND (agent.termination_reason EXISTS OR agy.termination_reason EXISTS)"
                    },
                    "disabled": false,
                    "limit": 100,
                    "groupBy": [
                      {
                        "name": "agent.termination_reason",
                        "fieldContext": "attribute",
                        "signal": "traces",
                        "fieldDataType": "string"
                      }
                    ],
                    "signal": "traces",
                    "legend": "{{agent.termination_reason}}",
                    "name": "A"
                  },
                  "kind": "signoz/BuilderQuery"
                }
              },
              "kind": "scalar"
            }
          ],
          "display": {
            "name": "Why Turns Ended",
            "description": "Distribution of termination reasons on Stop spans. NO_TOOL_CALL signifies healthy completion without further tool execution; USER_INTERRUPT or TURN_LIMIT indicate exceptions."
          }
        },
        "kind": "Panel"
      },
      "top-tools": {
        "spec": {
          "links": null,
          "plugin": {
            "spec": {
              "thresholds": null,
              "visualization": {
                "timePreference": "global_time"
              },
              "formatting": {
                "columnUnits": null,
                "decimalPrecision": "2"
              }
            },
            "kind": "signoz/TablePanel"
          },
          "queries": [
            {
              "spec": {
                "name": "A",
                "plugin": {
                  "spec": {
                    "source": "",
                    "order": [
                      {
                        "key": {
                          "name": "count()",
                          "fieldContext": "",
                          "signal": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "aggregations": [
                      {
                        "alias": "Calls",
                        "expression": "count()"
                      },
                      {
                        "alias": "Conversations",
                        "expression": "count_distinct(gen_ai.conversation.id)"
                      }
                    ],
                    "filter": {
                      "expression": "service.name IN $service_name AND (agent.hook.event = 'PostToolUse' OR agy.hook.event = 'PostToolUse') AND gen_ai.tool.name EXISTS"
                    },
                    "disabled": false,
                    "limit": 100,
                    "groupBy": [
                      {
                        "name": "gen_ai.tool.name",
                        "fieldContext": "attribute",
                        "signal": "traces",
                        "fieldDataType": "string"
                      }
                    ],
                    "signal": "traces",
                    "legend": "",
                    "name": "A"
                  },
                  "kind": "signoz/BuilderQuery"
                }
              },
              "kind": "scalar"
            }
          ],
          "display": {
            "name": "Top Tools",
            "description": "Total calls and distinct sessions per tool."
          }
        },
        "kind": "Panel"
      },
